generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  FARMER
  COOPERATIVE_STAFF
  BUYER
  ADMIN
  CONSUMER
}

enum BatchStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum OfferStatus {
  offered   @map("SUBMITTED")
  accepted  @map("ACCEPTED")
  rejected  @map("REJECTED")
  expired   @map("EXPIRED")
  delivered @map("RECEIVED")
  verified  @map("VERIFIED")
  paid      @map("PAID")

  @@map("HarvestOfferStatus")
}

enum TradeType {
  direct      @map("DIRECT_PURCHASE")
  consignment @map("CONSIGNMENT")

  @@map("SettlementType")
}

enum SettlementStatus {
  PENDING
  PARTIALLY_PAID
  PAID
}

enum PaymentMethod {
  daraja_b2c
}

enum PaymentPurpose {
  direct_purchase
  consignment
}

enum PaymentStatus {
  pending
  submitted
  succeeded
  failed
  timeout
}

enum CooperativeApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CooperativeMemberRole {
  OWNER
  MANAGER
  STAFF
}

enum NotificationType {
  COOPERATIVE_APPLICATION_SUBMITTED
  COOPERATIVE_APPLICATION_APPROVED
  COOPERATIVE_APPLICATION_REJECTED
  HARVEST_OFFER_SUBMITTED
  ORDER_CREATED
}

// ============================================
// MODELS
// ============================================

model Cooperative {
  id                 Int       @id @default(autoincrement())
  name               String    @unique
  village            String
  ward               String?
  county             String    @default("Baringo")
  walletAddress      String    @unique
  registrationNumber String?   @unique
  phone              String?
  isVerified         Boolean   @default(false)
  verifiedAt         DateTime?
  commissionPercent  Float     @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  users             User[]
  batches           HoneyBatch[]
  listings          Listing[]
  offers            Offer[]
  payments          Payment[]
  farmerSettlements FarmerSettlement[]
  memberships       CooperativeMembership[]
  applications      CooperativeApplication[]
}

model User {
  id               Int       @id @default(autoincrement())
  name             String
  phone            String    @unique
  email            String?   @unique
  passwordHash     String?
  googleId         String?   @unique
  emailVerifiedAt  DateTime?
  role             UserRole  @default(FARMER)
  cooperativeId    Int?
  walletAddress    String?
  ward             String?
  dataConsentAt    DateTime?
  ussdPinHash      String?
  farmerVerifiedAt DateTime?
  mpesaNumber      String?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  cooperative            Cooperative?             @relation(fields: [cooperativeId], references: [id])
  orders                 Order[]                  @relation("BuyerOrders")
  harvestLogs            HarvestLog[]
  offers                 Offer[]                  @relation("FarmerOffers")
  payments               Payment[]                @relation("FarmerPayments")
  farmerSettlements      FarmerSettlement[]       @relation("FarmerSettlements")
  emailVerificationToken EmailVerificationToken?
  cooperativeMembership  CooperativeMembership?   @relation("CooperativeMembershipUser")
  invitedMemberships     CooperativeMembership[]  @relation("CooperativeMembershipInviter")
  submittedApplications  CooperativeApplication[] @relation("CooperativeApplicationApplicant")
  reviewedApplications   CooperativeApplication[] @relation("CooperativeApplicationReviewer")
  notificationRecipients NotificationRecipient[]

  @@index([cooperativeId])
}

model CooperativeApplication {
  id                 Int                          @id @default(autoincrement())
  applicantId        Int
  name               String
  village            String
  ward               String
  county             String                       @default("Baringo")
  walletAddress      String
  registrationNumber String
  phone              String
  commissionPercent  Float                        @default(0)
  status             CooperativeApplicationStatus @default(PENDING)
  rejectionReason    String?
  reviewedById       Int?
  reviewedAt         DateTime?
  cooperativeId      Int?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  applicant   User         @relation("CooperativeApplicationApplicant", fields: [applicantId], references: [id])
  reviewedBy  User?        @relation("CooperativeApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  cooperative Cooperative? @relation(fields: [cooperativeId], references: [id], onDelete: SetNull)

  @@index([applicantId, status])
  @@index([status, createdAt])
  @@index([reviewedById])
  @@index([cooperativeId])
}

model CooperativeMembership {
  id              Int                   @id @default(autoincrement())
  cooperativeId   Int
  userId          Int                   @unique
  role            CooperativeMemberRole @default(STAFF)
  isActive        Boolean               @default(true)
  invitedByUserId Int?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])
  user          User        @relation("CooperativeMembershipUser", fields: [userId], references: [id])
  invitedByUser User?       @relation("CooperativeMembershipInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([cooperativeId, userId])
  @@index([cooperativeId, isActive, role])
  @@index([invitedByUserId])
}

model Notification {
  id         Int              @id @default(autoincrement())
  type       NotificationType
  title      String
  message    String
  entityType String?
  entityId   String?
  createdAt  DateTime         @default(now())

  recipients NotificationRecipient[]

  @@unique([type, entityType, entityId])
  @@index([createdAt])
  @@index([entityType, entityId])
}

model NotificationRecipient {
  id             Int       @id @default(autoincrement())
  notificationId Int
  userId         Int
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt, createdAt])
  @@index([notificationId])
}

model HoneyBatch {
  id               Int         @id @default(autoincrement())
  batchId          String      @unique
  cooperativeId    Int
  village          String
  harvestDate      DateTime
  moistureContent  Float
  weightKg         Float
  pricePerKg       Float?
  blockchainTxHash String?     @unique
  lotIdsHash       String?     @unique
  qrCodeUrl        String?
  status           BatchStatus @default(AVAILABLE)
  createdByUserId  Int?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  cooperative Cooperative @relation(fields: [cooperativeId], references: [id])
  listings    Listing[]
  offers      Offer[]

  @@index([cooperativeId])
  @@index([status])
}

model Offer {
  id                        Int         @id @default(autoincrement())
  reference                 String      @unique
  ussdSessionId             String?     @unique
  farmerId                  Int
  cooperativeId             Int
  ward                      String      @map("pickupVillage")
  offeredKg                 Decimal     @map("offeredWeightKg") @db.Decimal(12, 3)
  expectedPricePerKg        Decimal     @default(0) @db.Decimal(12, 2)
  tradeType                 TradeType   @map("settlementType")
  commissionPercent         Decimal     @db.Decimal(5, 2)
  agreedPricePerKg          Decimal?    @db.Decimal(12, 2)
  weighedKg                 Decimal?    @map("acceptedWeightKg") @db.Decimal(12, 3)
  moisturePercent           Decimal?    @db.Decimal(5, 2)
  expiresAt                 DateTime
  status                    OfferStatus @default(offered)
  rejectionReason           String?
  batchId                   Int?        @map("honeyBatchId")
  saleAmount                Decimal?    @db.Decimal(14, 2)
  paymentDetailsConfirmedAt DateTime?
  batchReservationToken     String?
  offeredAt                 DateTime
  acceptedAt                DateTime?
  rejectedAt                DateTime?
  expiredAt                 DateTime?
  deliveredAt               DateTime?
  verifiedAt                DateTime?
  paidAt                    DateTime?
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  farmer           User              @relation("FarmerOffers", fields: [farmerId], references: [id])
  cooperative      Cooperative       @relation(fields: [cooperativeId], references: [id])
  batch            HoneyBatch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
  payments         Payment[]
  legacySettlement FarmerSettlement?

  @@index([farmerId, createdAt])
  @@index([cooperativeId, status, expiresAt])
  @@index([cooperativeId, status, batchId])
  @@index([batchReservationToken])
  @@map("HarvestOffer")
}

model Payment {
  id                       Int            @id @default(autoincrement())
  offerId                  Int
  farmerId                 Int
  cooperativeId            Int
  amount                   Int
  method                   PaymentMethod  @default(daraja_b2c)
  reference                String         @unique
  purpose                  PaymentPurpose
  status                   PaymentStatus  @default(pending)
  originatorConversationId String?
  conversationId           String?
  transactionId            String?
  resultCode               Int?
  resultDescription        String?
  requestedAt              DateTime       @default(now())
  submittedAt              DateTime?
  completedAt              DateTime?
  failedAt                 DateTime?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  offer       Offer       @relation(fields: [offerId], references: [id])
  farmer      User        @relation("FarmerPayments", fields: [farmerId], references: [id])
  cooperative Cooperative @relation(fields: [cooperativeId], references: [id])

  @@unique([offerId, purpose])
  @@index([farmerId, status])
  @@index([cooperativeId, status])
  @@index([originatorConversationId])
  @@index([conversationId])
}

/// Legacy compatibility only. Active payout code uses Payment.
model FarmerSettlement {
  id               Int              @id @default(autoincrement())
  offerId          Int              @unique
  farmerId         Int
  cooperativeId    Int
  type             TradeType
  grossAmount      Float
  commissionAmount Float
  netAmount        Float
  amountPaid       Float            @default(0)
  status           SettlementStatus @default(PENDING)
  paymentReference String?
  paidAt           DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  offer       Offer       @relation(fields: [offerId], references: [id])
  farmer      User        @relation("FarmerSettlements", fields: [farmerId], references: [id])
  cooperative Cooperative @relation(fields: [cooperativeId], references: [id])

  @@index([farmerId, status])
  @@index([cooperativeId, status])
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Listing {
  id            Int      @id @default(autoincrement())
  batchId       Int
  cooperativeId Int
  quantityKg    Float
  pricePerKg    Float
  description   String?
  imageUrl      String?
  isAvailable   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  batch       HoneyBatch  @relation(fields: [batchId], references: [id])
  cooperative Cooperative @relation(fields: [cooperativeId], references: [id])
  orders      Order[]

  @@index([batchId])
  @@index([cooperativeId])
  @@index([isAvailable])
}

model Order {
  id         Int         @id @default(autoincrement())
  listingId  Int
  buyerId    Int
  quantityKg Float
  totalPrice Float
  status     OrderStatus @default(PENDING)
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  listing Listing @relation(fields: [listingId], references: [id])
  buyer   User    @relation("BuyerOrders", fields: [buyerId], references: [id])

  @@index([buyerId])
  @@index([listingId])
  @@index([status])
}

model PriceHistory {
  id         Int      @id @default(autoincrement())
  grade      String
  pricePerKg Float
  source     String   @default("manual")
  recordedAt DateTime @default(now())

  @@index([grade])
  @@index([recordedAt])
}

// ============================================
// USSD MODELS
// ============================================

model HarvestLog {
  id            Int      @id @default(autoincrement())
  userId        Int
  weightKg      Float
  loggedVia     String   @default("USSD")
  ussdSessionId String?  @unique
  notes         String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model UssdSession {
  id          String   @id
  phoneNumber String
  currentStep String?
  data        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phoneNumber])
}

model SmsLog {
  id          Int      @id @default(autoincrement())
  phoneNumber String
  message     String
  status      String   @default("sent")
  provider    String   @default("africastalking")
  error       String?
  createdAt   DateTime @default(now())

  @@index([phoneNumber])
  @@index([createdAt])
}
