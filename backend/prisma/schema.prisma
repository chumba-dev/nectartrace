generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  FARMER
  COOPERATIVE_STAFF
  BUYER
  ADMIN
}

enum BatchStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}

// ============================================
// MODELS
// ============================================

model Cooperative {
  id                 Int      @id @default(autoincrement())
  name               String   @unique
  village            String
  county             String   @default("Baringo")
  walletAddress      String   @unique
  registrationNumber String?  @unique
  phone              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users              User[]
  batches            HoneyBatch[]
  listings           Listing[]
}

model User {
  id             Int      @id @default(autoincrement())
  name           String
  phone          String   @unique
  email          String?  @unique
  passwordHash   String
  role           UserRole @default(FARMER)
  cooperativeId  Int?
  walletAddress  String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cooperative    Cooperative? @relation(fields: [cooperativeId], references: [id])
  orders         Order[]      @relation("BuyerOrders")
  harvestLogs    HarvestLog[]

  @@index([cooperativeId])
}

model HoneyBatch {
  id                Int         @id @default(autoincrement())
  batchId           String      @unique
  cooperativeId     Int
  village           String
  harvestDate       DateTime
  moistureContent   Float
  weightKg          Float
  pricePerKg        Float?
  blockchainTxHash  String?     @unique
  qrCodeUrl         String?
  status            BatchStatus @default(AVAILABLE)
  createdByUserId   Int?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  cooperative       Cooperative @relation(fields: [cooperativeId], references: [id])
  listings          Listing[]

  @@index([cooperativeId])
  @@index([status])
}

model Listing {
  id             Int      @id @default(autoincrement())
  batchId        Int
  cooperativeId  Int
  quantityKg     Float
  pricePerKg     Float
  description    String?
  isAvailable    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  batch          HoneyBatch @relation(fields: [batchId], references: [id])
  cooperative    Cooperative @relation(fields: [cooperativeId], references: [id])
  orders         Order[]

  @@index([batchId])
  @@index([cooperativeId])
  @@index([isAvailable])
}

model Order {
  id          Int         @id @default(autoincrement())
  listingId   Int
  buyerId     Int
  quantityKg  Float
  totalPrice  Float
  status      OrderStatus @default(PENDING)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  listing     Listing     @relation(fields: [listingId], references: [id])
  buyer       User        @relation("BuyerOrders", fields: [buyerId], references: [id])

  @@index([buyerId])
  @@index([listingId])
  @@index([status])
}

model PriceHistory {
  id          Int      @id @default(autoincrement())
  grade       String
  pricePerKg  Float
  source      String   @default("manual")
  recordedAt  DateTime @default(now())

  @@index([grade])
  @@index([recordedAt])
}


// ============================================
// USSD MODELS
// ============================================

model HarvestLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  weightKg    Float
  loggedVia   String   @default("USSD")
  notes       String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model UssdSession {
  id          String   @id
  phoneNumber String
  currentStep String?
  data        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phoneNumber])
}

model SmsLog {
  id          Int      @id @default(autoincrement())
  phoneNumber String
  message     String
  status      String   @default("sent")
  provider    String   @default("africastalking")
  error       String?
  createdAt   DateTime @default(now())

  @@index([phoneNumber])
  @@index([createdAt])
}