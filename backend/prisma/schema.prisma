generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  FARMER
  COOPERATIVE_STAFF
  BUYER
  ADMIN
}

enum BatchStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum HarvestOfferStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  RECEIVED
  VERIFIED
}

enum SettlementType {
  DIRECT_PURCHASE
  CONSIGNMENT
}

enum SettlementStatus {
  PENDING
  PARTIALLY_PAID
  PAID
}

// ============================================
// MODELS
// ============================================

model Cooperative {
  id                 Int      @id @default(autoincrement())
  name               String   @unique
  village            String
  county             String   @default("Baringo")
  walletAddress      String   @unique
  registrationNumber String?  @unique
  phone              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users             User[]
  batches           HoneyBatch[]
  listings          Listing[]
  harvestOffers     HarvestOffer[]
  farmerSettlements FarmerSettlement[]
}

model User {
  id              Int       @id @default(autoincrement())
  name            String
  phone           String    @unique
  email           String?   @unique
  passwordHash    String?
  googleId        String?   @unique
  emailVerifiedAt DateTime?
  role            UserRole  @default(FARMER)
  cooperativeId   Int?
  walletAddress   String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  cooperative            Cooperative?            @relation(fields: [cooperativeId], references: [id])
  orders                 Order[]                 @relation("BuyerOrders")
  harvestLogs            HarvestLog[]
  harvestOffers          HarvestOffer[]          @relation("FarmerHarvestOffers")
  farmerSettlements      FarmerSettlement[]      @relation("FarmerSettlements")
  emailVerificationToken EmailVerificationToken?

  @@index([cooperativeId])
}

model HoneyBatch {
  id               Int         @id @default(autoincrement())
  batchId          String      @unique
  cooperativeId    Int
  village          String
  harvestDate      DateTime
  moistureContent  Float
  weightKg         Float
  pricePerKg       Float?
  blockchainTxHash String?     @unique
  qrCodeUrl        String?
  status           BatchStatus @default(AVAILABLE)
  createdByUserId  Int?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  cooperative  Cooperative   @relation(fields: [cooperativeId], references: [id])
  listings     Listing[]
  harvestOffer HarvestOffer?

  @@index([cooperativeId])
  @@index([status])
}

model HarvestOffer {
  id                 Int                @id @default(autoincrement())
  reference          String             @unique
  ussdSessionId      String?            @unique
  farmerId           Int
  cooperativeId      Int
  pickupVillage      String
  offeredWeightKg    Float
  expectedPricePerKg Float?
  settlementType     SettlementType
  status             HarvestOfferStatus @default(SUBMITTED)
  acceptedWeightKg   Float?
  agreedPricePerKg   Float?
  rejectionReason    String?
  honeyBatchId       Int?               @unique
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  farmer      User              @relation("FarmerHarvestOffers", fields: [farmerId], references: [id])
  cooperative Cooperative       @relation(fields: [cooperativeId], references: [id])
  batch       HoneyBatch?       @relation(fields: [honeyBatchId], references: [id])
  settlement  FarmerSettlement?

  @@index([farmerId, createdAt])
  @@index([cooperativeId, status])
}

model FarmerSettlement {
  id               Int              @id @default(autoincrement())
  offerId          Int              @unique
  farmerId         Int
  cooperativeId    Int
  type             SettlementType
  grossAmount      Float
  commissionAmount Float
  netAmount        Float
  amountPaid       Float            @default(0)
  status           SettlementStatus @default(PENDING)
  paymentReference String?
  paidAt           DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  offer       HarvestOffer @relation(fields: [offerId], references: [id])
  farmer      User         @relation("FarmerSettlements", fields: [farmerId], references: [id])
  cooperative Cooperative  @relation(fields: [cooperativeId], references: [id])

  @@index([farmerId, status])
  @@index([cooperativeId, status])
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Listing {
  id            Int      @id @default(autoincrement())
  batchId       Int
  cooperativeId Int
  quantityKg    Float
  pricePerKg    Float
  description   String?
  imageUrl      String?
  isAvailable   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  batch       HoneyBatch  @relation(fields: [batchId], references: [id])
  cooperative Cooperative @relation(fields: [cooperativeId], references: [id])
  orders      Order[]

  @@index([batchId])
  @@index([cooperativeId])
  @@index([isAvailable])
}

model Order {
  id         Int         @id @default(autoincrement())
  listingId  Int
  buyerId    Int
  quantityKg Float
  totalPrice Float
  status     OrderStatus @default(PENDING)
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  listing Listing @relation(fields: [listingId], references: [id])
  buyer   User    @relation("BuyerOrders", fields: [buyerId], references: [id])

  @@index([buyerId])
  @@index([listingId])
  @@index([status])
}

model PriceHistory {
  id         Int      @id @default(autoincrement())
  grade      String
  pricePerKg Float
  source     String   @default("manual")
  recordedAt DateTime @default(now())

  @@index([grade])
  @@index([recordedAt])
}

// ============================================
// USSD MODELS
// ============================================

model HarvestLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  weightKg  Float
  loggedVia String   @default("USSD")
  notes     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model UssdSession {
  id          String   @id
  phoneNumber String
  currentStep String?
  data        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phoneNumber])
}

model SmsLog {
  id          Int      @id @default(autoincrement())
  phoneNumber String
  message     String
  status      String   @default("sent")
  provider    String   @default("africastalking")
  error       String?
  createdAt   DateTime @default(now())

  @@index([phoneNumber])
  @@index([createdAt])
}
