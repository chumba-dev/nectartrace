PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://user:password@localhost:5432/nectartrace"
MONGODB_URI="mongodb://127.0.0.1:27017/nectartrace"
OFFER_EXPIRY_INTERVAL_MS=60000
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
USSD_EVENT_SECRET=use_a_separate_long_random_value_in_production
AT_API_KEY=your_africas_talking_api_key
AT_USERNAME=sandbox
AT_SHORTCODE=*483#
AT_SENDER_ID=

# Daraja B2C sandbox only. Use the sandbox-generated encrypted security credential.
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_B2C_SHORTCODE=
DARAJA_B2C_INITIATOR_NAME=
DARAJA_B2C_SECURITY_CREDENTIAL=
DARAJA_B2C_RESULT_URL=
DARAJA_B2C_TIMEOUT_URL=
RPC_URL=http://127.0.0.1:8545
PRIVATE_KEY=your_wallet_private_key
CONTRACT_ADDRESS=
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_AMOY_PRIVATE_KEY=
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your_mailtrap_smtp_username
SMTP_PASS=your_mailtrap_smtp_password
SMTP_FROM="NectarTrace <no-reply@nectartrace.local>"
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your_google_oauth_client_id
EMAIL_VERIFICATION_TTL_MINUTES=60

# Seed overrides. Built-in defaults are development-only; production requires explicit credentials.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=
SEED_COOPERATIVE_NAME=
SEED_COOPERATIVE_VILLAGE=
SEED_COOPERATIVE_WARD=
SEED_COOPERATIVE_COUNTY=
SEED_COOPERATIVE_WALLET_ADDRESS=
SEED_COOPERATIVE_REGISTRATION_NUMBER=
SEED_COOPERATIVE_PHONE=
SEED_COOPERATIVE_COMMISSION_PERCENT=
SEED_STAFF_NAME=
SEED_STAFF_EMAIL=
SEED_STAFF_PHONE=
SEED_STAFF_PASSWORD=
SEED_FARMER_NAME=
SEED_FARMER_EMAIL=
SEED_FARMER_PHONE=
SEED_FARMER_PASSWORD=
SEED_BUYER_NAME=
SEED_BUYER_EMAIL=
SEED_BUYER_PHONE=
SEED_BUYER_PASSWORD=
SEED_CONSUMER_NAME=
